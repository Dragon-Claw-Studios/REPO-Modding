    <effect id="BinMaterial_10-effect">
      <profile_COMMON>
        <newparam sid="IMG10-surface">
          <surface type="2D">
            <init_from>IMG10</init_from>
          </surface>
        </newparam>
        <newparam sid="IMG10-sampler">
          <sampler2D>
